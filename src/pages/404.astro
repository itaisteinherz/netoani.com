---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404: Not Found">
	<h1>Page not found</h1>
	<p>This page doesn't exist. <a href="/">See all posts</a>.</p>
</Layout>

<style>
	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.5rem, 7vw, 3.75rem);
		font-weight: 250;
		line-height: 1.08;
		letter-spacing: -0.025em;
	}
</style>
