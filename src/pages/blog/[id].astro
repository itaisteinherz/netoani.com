---
import {render} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Bio from "../../components/Bio.astro";
import Date from "../../components/Date.astro";
import {getPosts, postUrl} from "../../posts.js";

export const getStaticPaths = async () => {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: {id: post.id},
		props: {
			post,
			previous: posts[index - 1],
			next: posts[index + 1],
		},
	}));
};

const {post, previous, next} = Astro.props;
const {Content} = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<article itemscope itemtype="https://schema.org/Article">
		<header>
			<Date date={post.data.date}/>
			<h1>{post.data.title}</h1>
		</header>
		<section itemprop="articleBody">
			<Content/>
		</section>
		<hr>
		<footer>
			<Bio/>
		</footer>
	</article>
	<nav>
		<ul>
			<li class="previous">
				{previous && <a href={postUrl(previous)} rel="prev">← {previous.data.title}</a>}
			</li>
			<li class="next">
				{next && <a href={postUrl(next)} rel="next">{next.data.title} →</a>}
			</li>
		</ul>
	</nav>
</Layout>

<style>
	h1 {
		margin-top: 0;
		margin-bottom: 1.8rem;
		font-size: 2.2974rem;
	}

	hr {
		margin-bottom: 1.8rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		margin: 0 0 1.8rem;
		padding: 0;
		list-style: none;
	}

	.previous {
		margin-right: 2.7rem;
	}

	.next {
		margin-left: auto;
	}
</style>
