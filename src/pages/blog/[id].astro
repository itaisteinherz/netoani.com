---
import {render} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Bio from "../../components/Bio.astro";
import Date from "../../components/Date.astro";
import {getPosts, postUrl} from "../../posts.js";

export const getStaticPaths = async () => {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: {id: post.id},
		props: {
			post,
			previous: posts[index - 1],
			next: posts[index + 1],
		},
	}));
};

const {post, previous, next} = Astro.props;
const {Content} = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<article itemscope itemtype="https://schema.org/Article">
		<header>
			<Date date={post.data.date}/>
			<h1>{post.data.title}</h1>
			<p class="standfirst">{post.data.description}</p>
		</header>
		<section itemprop="articleBody">
			<Content/>
		</section>
		<hr>
		<footer>
			<Bio/>
		</footer>
	</article>
	{(previous || next) && (
		<nav aria-label="More posts">
			{previous && (
				<a class="previous" href={postUrl(previous)} rel="prev">
					<span>Previous</span>
					{previous.data.title}
				</a>
			)}
			{next && (
				<a class="next" href={postUrl(next)} rel="next">
					<span>Next</span>
					{next.data.title}
				</a>
			)}
		</nav>
	)}
</Layout>

<style>
	article > header {
		margin-bottom: 3rem;
	}

	h1 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(2.5rem, 7vw, 3.75rem);
		font-weight: 250;
		line-height: 1.08;
		letter-spacing: -0.025em;
	}

	.standfirst {
		margin: 0;
		color: var(--muted);
		font-size: 1.375rem;
		font-style: italic;
		font-weight: 300;
		line-height: 1.45;
	}

	nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	nav a {
		color: var(--ink);
		line-height: 1.3;
		text-decoration: none;
	}

	nav a:hover {
		color: var(--link);
	}

	nav span {
		display: block;
		margin-bottom: 0.25rem;
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 500;
	}

	.next {
		grid-column: 2;
		text-align: right;
	}

	@media (max-width: 40rem) {
		nav {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.next {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
