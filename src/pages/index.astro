---
import Layout from "../layouts/Layout.astro";
import Bio from "../components/Bio.astro";
import {getPosts, postUrl} from "../posts.js";

const posts = await getPosts();
const years = Map.groupBy(posts.toReversed(), post => post.data.date.getUTCFullYear());
---

<Layout title="All posts">
	<h1 class="visually-hidden">All posts</h1>
	{[...years].map(([year, yearPosts]) => (
		<section class="year">
			<h2>{year}</h2>
			<ol>
				{yearPosts.map(post => (
					<li>
						<article itemscope itemtype="https://schema.org/Article">
							<h3>
								<a href={postUrl(post)} itemprop="url">
									<span itemprop="headline">{post.data.title}</span>
								</a>
							</h3>
							<p itemprop="description">{post.data.description}</p>
						</article>
					</li>
				))}
			</ol>
		</section>
	))}
	<hr>
	<footer>
		<Bio/>
	</footer>
</Layout>

<style>
	.year {
		position: relative;
		margin-bottom: 3rem;
	}

	h2 {
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.9375rem;
		font-weight: 400;
		font-variant-numeric: lining-nums tabular-nums;
		line-height: inherit;
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li + li {
		margin-top: 2.5rem;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--link);
	}

	p {
		margin: 0;
		color: var(--muted);
	}

	/* On wide screens the years hang in the left margin, beside the first title */
	@media (min-width: 60rem) {
		h2 {
			position: absolute;
			top: 0.45rem;
			right: calc(100% + 2rem);
			margin: 0;
		}
	}
</style>
