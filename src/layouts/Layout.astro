---
import {site} from "../site.js";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const {title, description = site.description} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<script is:inline>
			// Apply a saved theme before the page paints
			try {
				const theme = localStorage.getItem("theme");
				if (theme) {
					document.documentElement.dataset.theme = theme;
				}
			} catch {}
		</script>
		<title>{title} | {site.title}</title>
		<meta name="description" content={description}>
		<meta name="theme-color" content="#fbfdfc" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#18211f" media="(prefers-color-scheme: dark)">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:type" content="website">
		<meta name="twitter:card" content="summary">
		<meta name="twitter:creator" content={site.social.twitter}>
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap">
	</head>
	<body>
		<div class="page">
			<header>
				<a class="wordmark" href="/" aria-label={`${site.title} home`}>netoani</a>
				<ThemeToggle/>
			</header>
			<main>
				<slot/>
			</main>
		</div>
	</body>
</html>

<style>
	.page {
		max-width: calc(var(--measure) + 2.5rem);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 5rem;
	}

	.wordmark {
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1.25rem;
		font-weight: 650;
		letter-spacing: -0.04em;
		text-decoration: none;
	}

	@media (max-width: 40rem) {
		header {
			margin-bottom: 3.5rem;
		}
	}
</style>
