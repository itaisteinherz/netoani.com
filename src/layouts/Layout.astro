---
import {site} from "../site.js";
import "../styles/global.css";

const {title, description = site.description} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title} | {site.title}</title>
		<meta name="description" content={description}>
		<meta name="theme-color" content="#fbfdfc" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0f1a18" media="(prefers-color-scheme: dark)">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:type" content="website">
		<meta name="twitter:card" content="summary">
		<meta name="twitter:creator" content={site.social.twitter}>
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=JetBrains+Mono:wght@400;500&display=swap">
	</head>
	<body>
		<div class="page">
			<header>
				<a class="wordmark" href="/">{site.title}</a>
				<a class="feed" href="/rss.xml">RSS</a>
			</header>
			<main>
				<slot/>
			</main>
		</div>
	</body>
</html>

<style>
	.page {
		max-width: calc(var(--measure) + 2.5rem);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}

	header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 5rem;
	}

	header a {
		text-decoration: none;
	}

	.wordmark {
		color: var(--ink);
		font-size: 1.3125rem;
		font-style: italic;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.feed {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.feed:hover {
		color: var(--link);
	}

	@media (max-width: 40rem) {
		header {
			margin-bottom: 3.5rem;
		}
	}
</style>
