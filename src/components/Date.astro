---
import {formatDate} from "../posts.js";

const {date} = Astro.props;
---

<time datetime={date.toISOString()}>{formatDate(date)}</time>

<style>
	time {
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 500;
		font-variant-numeric: lining-nums tabular-nums;
	}
</style>
