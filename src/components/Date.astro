---
import {formatDate, formatMonth} from "../posts.js";

// Shows only the month and year when `month` is set
const {date, month = false} = Astro.props;
---

<time datetime={date.toISOString()}>{month ? formatMonth(date) : formatDate(date)}</time>

<style>
	time {
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 500;
		font-variant-numeric: lining-nums tabular-nums;
	}
</style>
