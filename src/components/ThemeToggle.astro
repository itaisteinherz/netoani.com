<button class="theme-toggle" type="button" aria-label="Switch to dark theme">
	<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/>
	</svg>
	<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"/>
		<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const button = document.querySelector(".theme-toggle");
	const systemDark = matchMedia("(prefers-color-scheme: dark)");

	const currentTheme = () => root.dataset.theme ?? (systemDark.matches ? "dark" : "light");

	const updateLabel = () => {
		button.setAttribute("aria-label", currentTheme() === "dark" ? "Switch to light theme" : "Switch to dark theme");
	};

	const setTheme = theme => {
		const systemTheme = systemDark.matches ? "dark" : "light";
		// Choosing the system's theme goes back to following the system
		if (theme === systemTheme) {
			delete root.dataset.theme;
		} else {
			root.dataset.theme = theme;
		}

		try {
			if (theme === systemTheme) {
				localStorage.removeItem("theme");
			} else {
				localStorage.setItem("theme", theme);
			}
		} catch {}

		updateLabel();
	};

	button.addEventListener("click", () => {
		const next = currentTheme() === "dark" ? "light" : "dark";
		if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
			document.startViewTransition(() => setTheme(next));
		} else {
			setTheme(next);
		}
	});

	systemDark.addEventListener("change", updateLabel);
	updateLabel();
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-right: -0.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--muted);
		cursor: pointer;
	}

	.theme-toggle:hover {
		background: var(--tint);
		color: var(--ink);
	}

	svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentcolor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Show the theme the button switches to */
	.sun {
		display: none;
	}

	:global(:root[data-theme="dark"]) .sun {
		display: block;
	}

	:global(:root[data-theme="dark"]) .moon {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme="light"])) .sun {
			display: block;
		}

		:global(:root:not([data-theme="light"])) .moon {
			display: none;
		}
	}
</style>
